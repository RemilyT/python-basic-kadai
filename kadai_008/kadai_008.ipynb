        "import random\n",
        "\n",
        "var = random.randint(0, 15)\n",
        "\n",
        "print(var)\n",
        "\n",
        "if var == 0:\n",
        "  print(var)\n",
        "\n",
        "elif var % 3 == 0 and var % 5 == 0:\n",
        "  print(\"FizzBuzz\")\n",
        "\n",
        "elif var % 3 == 0:\n",
        "  print(\"Fizz\")\n",
        "\n",
        "elif var % 5 == 0:\n",
        "  print(\"Buzz\")\n",
        "\n",
        "else:\n",
        "  print(var)"
      ]
